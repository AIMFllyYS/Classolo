# Classolo 环境变量模板 —— 复制为 .env.local 使用；真实 .env* 禁止提交。
# 密钥优先级：设置页/Electron 用户填写 > 本文件（ADR-0013）。用户覆盖非空时忽略这里的 key。

# ── AI 模型（Vercel AI SDK + OpenAI 兼容协议，任意兼容网关均可）──
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ── 实时语音转文字（ASR）——按协议族配置，详见 docs/adr/0004 ──
# 协议族: realtime-ws（真流式，上课默认）| transcriptions-rest（文件式/切片伪流式）| local（sherpa-onnx 离线）
ASR_FAMILY=realtime-ws
# realtime-ws 方言: stepfun（阶跃 stepaudio-2.5-asr-stream）| qwen（百炼 qwen3-asr-flash-realtime）
ASR_DIALECT=stepfun
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_SAMPLE_RATE=16000

# ── 图片检索（渲染区 image 模块，可选）──
IMAGE_SEARCH_API_KEY=

# ── 1037Solo 生态迁移预留（P0-P2 全程不用，保持注释）──
# NEXT_PUBLIC_SOLO_ACCOUNT_URL=https://account.1037solo.com
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# MAIL_PUSH_API_KEY=
